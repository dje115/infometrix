    "@mui/x-data-grid": "^7.29.12",
    "@mui/x-date-pickers": "^7.29.4",
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "date-fns": "^2.30.0",
    "i18next": "^23.16.8",
    "react": "^19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.3",
    "react-i18next": "^13.5.0",
